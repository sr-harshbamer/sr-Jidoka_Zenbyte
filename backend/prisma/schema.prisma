generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// SQLite has no native enum support in Prisma — these are plain strings,
// validated against the corresponding TypeScript union types in
// src/engine/types.ts at the application layer instead.
//
// StepStatus:          ALLOW | WARN | PAUSE | REQUIRE_APPROVAL | BLOCK | TERMINATE
// RunStatus:           RUNNING | COMPLETED | BLOCKED | AWAITING_APPROVAL | TERMINATED
// Severity:            LOW | MEDIUM | HIGH | CRITICAL
// PolicyAction:        WARN | BLOCK | REQUIRE_APPROVAL
// InterventionDecision: PENDING | APPROVE | REJECT | APPROVE_ONCE | ALWAYS_ALLOW

model Agent {
  id          String   @id @default(cuid())
  name        String
  type        String
  description String
  createdAt   DateTime @default(now())
  status      String   @default("active") // active | paused | terminated

  runs AgentRun[]
}

model AgentRun {
  id          String    @id @default(cuid())
  agentId     String
  agent       Agent     @relation(fields: [agentId], references: [id])
  task        String
  scenarioKey String? // which scripted scenario drove this run, if any (demo mode)
  status      String    @default("RUNNING")
  startedAt   DateTime  @default(now())
  endedAt     DateTime?

  steps         AgentStep[]
  riskEvents    RiskEvent[]
  interventions HumanIntervention[]
  auditEvents   AuditEvent[]
}

model AgentStep {
  id          String   @id @default(cuid())
  runId       String
  run         AgentRun @relation(fields: [runId], references: [id])
  stepNumber  Int
  timestamp   DateTime @default(now())
  action      String
  tool        String?
  input       String // JSON-encoded
  output      String? // JSON-encoded
  reasoning   String?
  riskScore   Int      @default(0)
  riskFactors String? // JSON-encoded breakdown
  status      String   @default("ALLOW")

  toolCalls  ToolCall[]
  evidence   Evidence[]
  decisions  Decision[]
  riskEvents RiskEvent[]
}

model ToolCall {
  id         String    @id @default(cuid())
  stepId     String
  step       AgentStep @relation(fields: [stepId], references: [id])
  toolName   String
  params     String // JSON-encoded
  result     String? // JSON-encoded
  latencyMs  Int       @default(0)
  trusted    Boolean   @default(true)
  sourceType String    @default("simulated") // internal | external | simulated
}

model Policy {
  id          String   @id @default(cuid())
  name        String
  description String
  condition   String // JSON-encoded structured rule
  severity    String
  action      String
  enabled     Boolean  @default(true)
  createdAt   DateTime @default(now())
}

model RiskEvent {
  id                    String     @id @default(cuid())
  runId                 String
  run                   AgentRun   @relation(fields: [runId], references: [id])
  stepId                String?
  step                  AgentStep? @relation(fields: [stepId], references: [id])
  type                  String // POLICY_VIOLATION | ANOMALY | EVIDENCE_CONFLICT | PROMPT_INJECTION
  severity              String
  description           String
  riskScoreContribution Int
  detectedAt            DateTime   @default(now())
}

model Evidence {
  id            String    @id @default(cuid())
  stepId        String
  step          AgentStep @relation(fields: [stepId], references: [id])
  source        String
  sourceType    String    @default("trusted") // trusted | untrusted
  content       String
  retrievedAt   DateTime  @default(now())
  conflictsWith String? // id of the other Evidence record it conflicts with
}

model Decision {
  id        String   @id @default(cuid())
  stepId    String
  step      AgentStep @relation(fields: [stepId], references: [id])
  type      String // POLICY_EVAL | RISK_EVAL | HUMAN_APPROVAL
  outcome   String // ALLOW | BLOCK | APPROVE | REJECT
  reasoning String
  decidedBy String // system | human:<name>
  decidedAt DateTime @default(now())
}

model HumanIntervention {
  id              String    @id @default(cuid())
  runId           String
  run             AgentRun  @relation(fields: [runId], references: [id])
  stepId          String?
  requestedAt     DateTime  @default(now())
  respondedAt     DateTime?
  requestedAction String // JSON-encoded: what the agent wanted to do
  context         String // JSON-encoded: why flagged, policies, evidence, risk
  decision        String    @default("PENDING")
  respondedBy     String?
  notes           String?
}

model AuditEvent {
  id                String   @id @default(cuid())
  runId             String
  run               AgentRun @relation(fields: [runId], references: [id])
  timestamp         DateTime @default(now())
  eventType         String
  actor             String // agent | system | human
  summary           String
  fullPayload       String // JSON-encoded
  previousEventHash String?
  hash              String
}
